# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Neutara Ticketing ----
TICKETING_BASE_URL=https://neutaraticketing.cftools.live
TICKETING_API_KEY=paste-your-api-key-here

# After running `npm run probe`, these get auto-filled.
# Leave blank to let the client try multiple patterns automatically.
TICKETING_AUTH_STYLE=            # bearer | x-api-key | api-key | query
TICKETING_LIST_ENDPOINT=         # e.g. /api/tickets
TICKETING_DETAIL_ENDPOINT=       # e.g. /api/tickets/{id}

# ---- Sync ----
SYNC_INTERVAL_HOURS=6
SYNC_PAGE_SIZE=100
SYNC_ON_STARTUP=true

# ---- Server ----
PORT=5174
